# CCE Insights Service — Environment Variables
# Copy to .env and adjust values for your environment.

# Server
SERVER_PORT=8084

# Database (PostgreSQL — shared cce_collector database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cce_collector
DB_USERNAME=cce_user
DB_PASSWORD=cce_pass
DB_POOL_SIZE=10

# Spring profile (local | docker | test)
SPRING_PROFILES_ACTIVE=local
